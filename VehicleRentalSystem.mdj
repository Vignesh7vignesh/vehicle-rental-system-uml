{
  "_type": "Project",
  "_id": "project-vehicle-rental-system",
  "name": "Vehicle Rental System",
  "documentation": "Vehicle Rental System UML model containing 9 diagrams for Use Case, Class, Sequence, Activity, State, Component and Deployment views.",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "model-root",
      "name": "Vehicle Rental System",
      "ownedElements": [
        {
          "_type": "UMLPackage",
          "_id": "pkg-usecases",
          "name": "Use Cases",
          "ownedElements": [
            { "_type": "UMLActor", "_id": "actor-customer", "name": "Customer" },
            { "_type": "UMLActor", "_id": "actor-admin", "name": "Admin" },
            { "_type": "UMLActor", "_id": "actor-gateway", "name": "Payment Gateway" },
            { "_type": "UMLUseCase", "_id": "uc-register", "name": "Register / Login" },
            { "_type": "UMLUseCase", "_id": "uc-search", "name": "Search Vehicles" },
            { "_type": "UMLUseCase", "_id": "uc-book", "name": "Book Vehicle" },
            { "_type": "UMLUseCase", "_id": "uc-pay", "name": "Make Payment" },
            { "_type": "UMLUseCase", "_id": "uc-pickup", "name": "Pick up Vehicle" },
            { "_type": "UMLUseCase", "_id": "uc-return", "name": "Return Vehicle" },
            { "_type": "UMLUseCase", "_id": "uc-manage-vehicles", "name": "Manage Vehicles" },
            { "_type": "UMLUseCase", "_id": "uc-manage-customers", "name": "Manage Customers" },
            { "_type": "UMLUseCase", "_id": "uc-manage-rentals", "name": "Manage Rentals" },
            { "_type": "UMLUseCase", "_id": "uc-verify-payment", "name": "Verify Payment" },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-register", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-register" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-search", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-search" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-book", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-book" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-pay", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-pay" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-pickup", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-pickup" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-customer-return", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-customer" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-return" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-admin-vehicles", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-admin" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-manage-vehicles" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-admin-customers", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-admin" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-manage-customers" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-admin-rentals", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-admin" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-manage-rentals" } },
            { "_type": "UMLAssociation", "_id": "assoc-uc-gateway-verify", "end1": { "_type": "UMLAssociationEnd", "reference": "actor-gateway" }, "end2": { "_type": "UMLAssociationEnd", "reference": "uc-verify-payment" } },
            { "_type": "UMLInclude", "_id": "include-search-book", "addition": "uc-book", "additionEnd": "uc-book", "includingCase": "uc-search" },
            { "_type": "UMLInclude", "_id": "include-manage-rentals-pay", "addition": "uc-pay", "includingCase": "uc-manage-rentals" }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "pkg-domain",
          "name": "Domain Model",
          "ownedElements": [
            { "_type": "UMLClass", "_id": "class-customer", "name": "Customer", "attributes": ["- userId: int", "- name: string", "- email: string", "- licenseNo: string"], "operations": ["+ login()", "+ logout()", "+ searchVehicles()", "+ bookVehicle()", "+ returnVehicle()"] },
            { "_type": "UMLClass", "_id": "class-admin", "name": "Admin", "attributes": ["- adminId: int", "- name: string", "- email: string", "- employeeId: string"], "operations": ["+ login()", "+ logout()", "+ manageVehicle()", "+ manageCustomers()", "+ manageRentals()"] },
            { "_type": "UMLClass", "_id": "class-booking", "name": "Booking", "attributes": ["- bookingId: int", "- rentalPeriod: string", "- status: string"], "operations": ["+ calculateAmount()", "+ confirmBooking()"] },
            { "_type": "UMLClass", "_id": "class-vehicle", "name": "Vehicle", "attributes": ["- vehicleId: int", "- model: string", "- status: string"], "operations": ["+ checkAvailability()", "+ updateStatus()"] },
            { "_type": "UMLClass", "_id": "class-payment", "name": "Payment", "attributes": ["- paymentId: int", "- amount: float", "- status: string"], "operations": ["+ processPayment()"] },
            { "_type": "UMLClass", "_id": "class-payment-gateway", "name": "PaymentGateway", "attributes": ["- gatewayId: string", "- status: string"], "operations": ["+ verifyPayment()"] },
            { "_type": "UMLAssociation", "_id": "assoc-customer-booking", "source": "class-customer", "target": "class-booking", "name": "books", "lower": "0.*", "upper": "0.*" },
            { "_type": "UMLAssociation", "_id": "assoc-admin-vehicle", "source": "class-admin", "target": "class-vehicle", "name": "manages", "lower": "0.*", "upper": "0.*" },
            { "_type": "UMLAssociation", "_id": "assoc-booking-payment", "source": "class-booking", "target": "class-payment", "name": "paid by", "lower": "1", "upper": "1" },
            { "_type": "UMLAssociation", "_id": "assoc-payment-gateway", "source": "class-payment", "target": "class-payment-gateway", "name": "uses", "lower": "1", "upper": "1" },
            { "_type": "UMLAssociation", "_id": "assoc-booking-vehicle", "source": "class-booking", "target": "class-vehicle", "name": "reserved for", "lower": "1", "upper": "1" },
            { "_type": "UMLAssociation", "_id": "assoc-admin-rentals", "source": "class-admin", "target": "class-booking", "name": "manages rentals", "lower": "0.*", "upper": "0.*" }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "pkg-components",
          "name": "System Components",
          "ownedElements": [
            { "_type": "UMLComponent", "_id": "comp-booking-management", "name": "Booking Management" },
            { "_type": "UMLComponent", "_id": "comp-vehicle-management", "name": "Vehicle Management" },
            { "_type": "UMLComponent", "_id": "comp-payment-service", "name": "Payment Service" },
            { "_type": "UMLComponent", "_id": "comp-customer-management", "name": "Customer Management" },
            { "_type": "UMLComponent", "_id": "comp-database", "name": "Database" },
            { "_type": "UMLArtifact", "_id": "artifact-rental-db", "name": "RentalDB" },
            { "_type": "UMLArtifact", "_id": "artifact-payment-service", "name": "Payment Gateway Service" },
            { "_type": "UMLInterface", "_id": "iface-customer-details", "name": "Customer Details" },
            { "_type": "UMLInterface", "_id": "iface-vehicle-availability", "name": "Vehicle Availability" },
            { "_type": "UMLInterface", "_id": "iface-payment", "name": "Payment" }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "pkg-deployment",
          "name": "Deployment",
          "ownedElements": [
            { "_type": "UMLNode", "_id": "node-customer-device", "name": "Customer Device" },
            { "_type": "UMLNode", "_id": "node-admin-workstation", "name": "Admin Workstation" },
            { "_type": "UMLNode", "_id": "node-application-server", "name": "Application Server" },
            { "_type": "UMLNode", "_id": "node-database-server", "name": "Database Server" },
            { "_type": "UMLNode", "_id": "node-payment-gateway-server", "name": "Payment Gateway Server" }
          ]
        },
        {
          "_type": "UMLPackage",
          "_id": "pkg-sequences",
          "name": "Sequence Definitions",
          "ownedElements": [
            { "_type": "UMLLifeline", "_id": "seq-customer", "name": ":Customer" },
            { "_type": "UMLLifeline", "_id": "seq-booking", "name": ":Booking" },
            { "_type": "UMLLifeline", "_id": "seq-vehicle", "name": ":Vehicle" },
            { "_type": "UMLLifeline", "_id": "seq-payment", "name": ":Payment" },
            { "_type": "UMLLifeline", "_id": "seq-gateway", "name": ":PaymentGateway" },
            { "_type": "UMLLifeline", "_id": "seq-admin", "name": ":Admin" }
          ]
        }
      ]
    }
  ],
  "diagrams": [
